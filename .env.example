# ── Vulnix configuration (copy to .env, real environment wins) ──────────────

# Server
SERVER_HOST=127.0.0.1
PORT=5000
# Required when SERVER_HOST is not loopback; use a random secret of at least 32 characters.
# Enter this token in the UI when prompted.
VULNIX_API_TOKEN=

# ── LLM connection (everything AI is off until LLM_ENABLED=true) ────────────
# Two supported providers (selected by LLM_PROVIDER):
#   ollama  → local, private, recommended. Run `ollama serve` + `ollama pull <model>`.
#   openai  → any OpenAI-compatible server (OpenAI, Azure, OpenRouter, vLLM, ...).
# Verify after start: GET /api/ai/status, or the AI chip on the New Scan page.
LLM_ENABLED=false
LLM_PROVIDER=ollama            # ollama | openai
OLLAMA_HOST=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com   # no trailing slash; /v1 is appended
# OPENAI_API_KEY=sk-...
# LLM_MODEL=                   # auto-discovered when unset (prefers code/chat models)
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
LLM_MAX_PAYLOADS=12
# LLM_CONCURRENCY=2

# ── Autonomous agent budgets ────────────────────────────────────────────────
AGENT_MAX_STEPS=25
AGENT_MAX_REQUESTS=200
AGENT_MAX_SECONDS=600
AGENT_ALLOW_DESTRUCTIVE=false

# ── Deterministic scanner (non-AI engine only; never used by the agent) ─────
SCAN_MAX_REQUESTS=400          # cap on requests a single scan may issue
SCAN_MAX_SECONDS=120           # wall-clock cap (enforced per request)
SCAN_SKIP_STATIC_INJECTION=true  # skip injection battery on pages with no dynamic surface
SCAN_RATE_LIMIT_SAMPLES=4      # spaced probes used by the rate-limit check
# Same-origin API discovery + probing (SPA / JSON-API targets)
SCAN_DISCOVERY_SCRIPTS=3       # JS bundles mined for API paths
SCAN_DISCOVERY_ENDPOINTS=8     # top candidate endpoints actually probed
SCAN_DISCOVERY_PROBES=4        # probe requests allowed per endpoint
SCAN_DISCOVERY_POST=true       # allow POST auth-bypass probe on login endpoints
# Discovered-surface fuzzing (parameterised links + forms, type-appropriate)
SCAN_FUZZ_SURFACES=true        # fuzz every discovered input surface (fixed + AI payloads)
SCAN_DISCOVERY_SURFACES=12     # max discovered surfaces fuzzed per scan
# Recursive crawl depth (1 = target page only; N adds N-1 link hops)
SCAN_DISCOVERY_DEPTH=1
# Max number of visited pages during recursive crawl
SCAN_DISCOVERY_VISITED=30
# Probe common paths (e.g. /login, /api) even if not linked
SCAN_DISCOVERY_PROBE_COMMON=false
# Comma-separated common paths to probe when enabled
SCAN_DISCOVERY_COMMON_PATHS=/login,/signin,/register,/logout,/admin,/api,/api/v1,/api/v2,/api/users,/api/auth

# ── Safety / authorization ──────────────────────────────────────────────────
# Comma-separated host allowlist (empty = only the original scan target)
AUTHORIZED_TARGETS=
REQUIRE_AUTHORIZATION=true
ALLOW_INTERNAL_IPS=false
